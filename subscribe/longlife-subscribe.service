[Unit]
Description=LongLife email subscription API
After=network.target

[Service]
Type=simple
User=faion
Group=faion
WorkingDirectory=/home/faion/longlife-faion-net/subscribe
EnvironmentFile=/srv/longlife/subscribe.env
ExecStart=/usr/bin/python3 /home/faion/longlife-faion-net/subscribe/server.py
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only, not true: the service runs its code from the repo checkout under /home, so it
# must be able to read there; it writes only the database and WAL under /srv/longlife.
ProtectHome=read-only
ReadWritePaths=/srv/longlife
MemoryMax=256M

[Install]
WantedBy=multi-user.target
